# Your own MyRoadSafety login (this is YOUR account, not stored anywhere else)
RSA_EMAIL=you@example.com
RSA_PASSWORD=your-password-here

# Discord webhook used to send YOU the alerts (server/channel settings ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Polling behaviour
POLL_MIN_SECONDS=180
POLL_MAX_SECONDS=300

# Safety switch: set to "true" only once you've tested the whole flow in dry-run
AUTO_BOOK_ENABLED=false
