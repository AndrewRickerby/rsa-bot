# Your own MyRoadSafety login (this is YOUR account, not stored anywhere else)
RSA_EMAIL=you@example.com
RSA_PASSWORD=your-password-here

# Only needed on a host with no browser window of its own (e.g. Railway).
# Run `npm run setup-session` locally first - it logs in with a visible
# browser so you can complete RSA's SMS verification by hand, then prints
# the value to paste here. Leave blank when running locally; session.js
# will just use the session-state.json file that script wrote instead.
SESSION_STATE_B64=

# Discord webhook used to send YOU the alerts (server/channel settings ->
# Integrations -> Webhooks -> New Webhook -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which test centres to check, comma-separated, exact names as shown on
# the RSA site. Leave blank to check every centre listed on the booking page.
TEST_CENTRES=Finglas,Killester

# Date range to accept, inclusive, YYYY-MM-DD. Leave blank for either side
# to not restrict that end of the range.
EARLIEST_DATE=
LATEST_DATE=

# Day-of-week filter, comma-separated, 0=Sunday ... 6=Saturday. Leave blank
# to allow any day.
ALLOWED_DAYS_OF_WEEK=

# Time-of-day filter, inclusive, 24hr HH:MM. Leave blank for either side to
# not restrict that end of the range.
EARLIEST_TIME=
LATEST_TIME=

# Polling behaviour
POLL_MIN_SECONDS=180
POLL_MAX_SECONDS=300

# Safety switch: set to "true" only once you've tested the whole flow in dry-run
AUTO_BOOK_ENABLED=false
